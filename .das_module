options gen2
require daslib/fio

// Makes `require computation/<module>` and `require computation_task/<module>` resolve when this folder sits in a project's modules/.
[export]
def initialize(project_path : string) {
    let computation_modules = [
        "builder_protocol", "computation", "computation_builders", "computation_macro",
        "computation_resources", "coroutine_builder", "coroutine_scheduler", "deferred_computation",
        "deferred_runtime", "function_computation", "list_builder", "move_builders", "parser_builder",
        "resumable_lowering", "search_builder", "sequence_builder", "sequence_function",
        "sequence_runtime", "validation_builder", "zip_runtime"
    ]
    for (name in computation_modules) {
        register_native_path("computation", name, "{project_path}/packages/computation/{name}.das")
    }
    let computation_task_modules = [
        "async_sequence_builder", "cancellation_token", "task_builder", "task_channel",
        "task_combinators", "task_delay", "task_events", "task_function", "task_http", "task_hv",
        "task_jobque", "task_parallel", "task_progress", "task_runtime", "task_scheduler", "task_tcp"
    ]
    for (name in computation_task_modules) {
        register_native_path("computation_task", name, "{project_path}/packages/computation_task/{name}.das")
    }
}
